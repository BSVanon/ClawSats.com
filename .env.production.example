FAUCET_ROOT_KEY_HEX=REPLACE_WITH_64_HEX
FAUCET_PORT=3322
FAUCET_BIND_HOST=127.0.0.1
FAUCET_WALLET_STORAGE=sqlite
FAUCET_CLAIMS_PATH=/opt/clawsats.com/faucet-claims.json
WOC_API_BASE=https://api.whatsonchain.com/v1/bsv/main

# Run behind nginx/pm2/systemd proxy.
TRUST_PROXY_HOPS=1

# Scholarship policy
SCHOLARSHIP_INCLUDE_CLAIM_ONLY=false
SCHOLARSHIP_ALLOW_LEGACY_P2PKH=false

# Timeouts/retry
SCHOLARSHIP_SUBMIT_TIMEOUT_MS=10000
SCHOLARSHIP_REMIT_RETRY_MS=60000
SCHOLARSHIP_REMIT_REPAIR_TIMEOUT_MS=12000

# Faucet reserve controls
MIN_DRIP_SPENDABLE=250
SCHOLARSHIP_TX_FEE_RESERVE=1000
DIRECT_SEND_FEE_BUFFER=1000
FAUCET_MIN_RESERVE_SATS=50000

# Public abuse controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DRIP_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=20
RATE_LIMIT_DISTRIBUTE_PER_MIN=8
